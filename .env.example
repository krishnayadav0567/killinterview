# Copy this file to .env and configure your Judge0 server.
# Do not commit .env or put secrets in browser JavaScript.
# Use the host and port where your Judge0 API is exposed.
JUDGE0_URL=http://localhost:2358
# The current Judge0 1.10 image exposes Java (OpenJDK 13.0.1) as language ID 62.
# Language IDs vary by Judge0 release; confirm yours with GET /languages.
JUDGE0_LANGUAGE_ID=62
# Optional for protected Judge0 or RapidAPI-hosted instances.
JUDGE0_AUTH_TOKEN=
RAPIDAPI_KEY=
RAPIDAPI_HOST=
# PORT=3000
